// Визуальный стиль, эффект «Планы»: ближнее чуть насыщеннее и контрастнее, дальнее мягче, прохладнее и светлее.
// Одна функция расстояния от камеры, общая для рельефа, ближней растительности и дальнего леса: у границы
// LOD на обеих сторонах получается один и тот же тон (никаких швов), а дороги на рельефе меняются вместе с землёй.
// Параметры задаёт VisualStyle (global uniform, project.godot), уже умноженные на силу эффекта: x — ближний контраст,
// y — смягчение вдали, z — оттенок атмосферы вдали, w — 1, если эффект включён (0 — функция возвращает цвет без изменений).
// Цвет дымки style_haze задаёт DayCycle (цвет горизонта): дальний план связан с туманом и небом, а не с отдельной палитрой.
global uniform vec4 style_depth;
global uniform vec3 style_haze;

vec3 depth_tone(vec3 albedo, float dist) {
	if (style_depth.w <= 0.0) {
		return albedo;
	}
	// Ближний план: до ~25 м полная сила, к 160 м сходит на нет.
	float near = 1.0 - smoothstep(25.0, 160.0, dist);
	// Дальний план: начинается за ~200 м, к ~1000 м полная сила. Горы остаются на месте: меняются тон и насыщенность, не плотность.
	float far = smoothstep(200.0, 1000.0, dist);
	float luma = dot(albedo, vec3(0.2126, 0.7152, 0.0722));
	// Насыщенность: вблизи плюс, вдали минус (дальняя зелень сереет к цвету воздуха).
	// Вблизи насыщенность почти не растёт (зелень должна остаться спокойной), работает контраст по светлоте.
	float sat = 1.0 + style_depth.x * 0.05 * near - style_depth.y * 0.42 * far;
	vec3 c = mix(vec3(luma), albedo, sat);
	// Контраст относительно типичного альбедо сцены (0,22 в линейном пространстве; при 0,18 вблизи кадр заметно светлел): вблизи выше, вдали ниже.
	float contrast = 1.0 + style_depth.x * 0.15 * near - style_depth.y * 0.26 * far;
	c = pow(max(c, vec3(0.0001)) / 0.22, vec3(contrast)) * 0.22;
	// Дальний тон тянется к цвету дымки, сохраняя светлоту детали.
	vec3 haze = style_haze * (luma / max(dot(style_haze, vec3(0.2126, 0.7152, 0.0722)), 0.01));
	c = mix(c, haze, style_depth.z * 0.4 * far);
	return c;
}
