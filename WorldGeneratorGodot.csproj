<Project Sdk="Godot.NET.Sdk/4.7.2">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <!-- Численные циклы генерации должны быть быстрыми и при запуске из редактора. -->
    <Optimize>true</Optimize>
    <!-- A* (FastGrid.Path.cs) читает массивы по указателям: без проверок границ в горячем цикле. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>WorldGeneratorGodot</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- Archived measurement projects are data, not sources of the game. -->
    <Compile Remove="tools/control/runs/**/*.cs" />
  </ItemGroup>
</Project>
