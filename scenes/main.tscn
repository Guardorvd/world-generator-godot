[connection signal="value_changed" from="UI/Root/Settings/Panel/Box/VolumeSlider" to="." method="_on_volume_changed"]
[connection signal="pressed" from="UI/Root/Settings/Panel/Box/Reset" to="." method="_on_reset_settings"]
[connection signal="pressed" from="UI/Root/Settings/Panel/Box/Done" to="." method="_close_settings"]
[connection signal="value_changed" from="UI/Root/Settings/Panel/Box/DaySlider" to="." method="_on_day_changed"]
