custom_minimum_size = Vector2(0, 24)
layout_mode = 2
max_value = 120
step = 1

[node name="StartHourRow" type="HBoxContainer" parent="UI/Root/Settings/Panel/Box"]
layout_mode = 2

[node name="StartHourLabel" type="Label" parent="UI/Root/Settings/Panel/Box/StartHourRow"]
layout_mode = 2
size_flags_horizontal = 3
text = "Час начала"

[node name="StartHourValue" type="Label" parent="UI/Root/Settings/Panel/Box/StartHourRow"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0.8, 0.82, 0.85, 1)
text = "1"

[node name="StartHourSlider" type="HSlider" parent="UI/Root/Settings/Panel/Box"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 24)
layout_mode = 2
max_value = 23
step = 1

[node name="RandomHour" type="CheckBox" parent="UI/Root/Settings/Panel/Box"]
unique_name_in_owner = true
layout_mode = 2
text = "Случайный час начала"

[node name="Reset" type="Button" parent="UI/Root/Settings/Panel/Box"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 44)
layout_mode = 2
text = "Сбросить настройки"

[node name="Done" type="Button" parent="UI/Root/Settings/Panel/Box"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 44)
layout_mode = 2
theme_type_variation = &"PrimaryButton"
text = "Готово"

[connection signal="pressed" from="UI/Root/Pause/Panel/Box/Resume" to="." method="_resume"]
[connection signal="pressed" from="UI/Root/Pause/Panel/Box/Leave/ToMenu" to="." method="_confirm_to_menu"]
[connection signal="pressed" from="UI/Root/Pause/Panel/Box/Leave/Exit" to="." method="_confirm_exit"]
