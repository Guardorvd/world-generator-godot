extends RefCounted
## Шлемы седока (27.11): названия для магазина и формы для сборщика tools/build_cyclist.gd — всё в одном месте.
## Шлем — только форма: цвет скорлупы, канта и полосы берётся из расцветки (BikePalette.HELMET, NAVY, JERSEY),
## поэтому любой шлем подходит к любой расцветке. В сцене седока каждый шлем — свой меш на кости головы
## (узел MOUNT); BikeView.set_helmet показывает один из них.

const STOCK := "helmet_stock"
const MOUNT := "HelmetMount"

const NAMES := {STOCK: "Штатный", "helmet_dome": "Городской", "helmet_trail": "Трейловый", "helmet_aero": "Аэро"}
const DESCRIPTIONS := {
	STOCK: "Лёгкий кросс-кантрийный шлем с прорезями и коротким козырьком.",
	"helmet_dome": "Гладкая круглая скорлупа без прорезей, толстый кант и закрытый затылок, как у скейт-шлема.",
	"helmet_trail": "Глубокая посадка на затылке и висках, широкие прорези и длинный козырёк для езды по лесу.",
	"helmet_aero": "Вытянутая обтекаемая скорлупа с хвостом и без козырька — для быстрой езды по дорогам.",
}

## Формы в осях кости головы (м; −Z — вперёд). Низ скорлупы у всех на одной высоте (сборщик: HELMET_Y),
## чтобы ремешки, волосы и очки сидели одинаково под любым шлемом.
##   radius — полуоси низа скорлупы (ширина, длина), height — высота купола над низом;
##   tail — удлинение назад (перёд остаётся на месте); nape — нижняя точка затылка;
##   wrap — насколько затылочная часть заходит на виски (рад от середины затылка);
##   rim — кант по низу: (ниже края, выше края); visor — козырёк (ширина, толщина, вылет, наклон; ширина 0 — нет);
##   vents — прорези (смещение от середины), vent_width — их ширина, stripe — полоса цвета джерси посередине.
const FORMS := {
	STOCK: {radius = Vector2(0.118, 0.138), height = 0.112, tail = 0.0, nape = -0.012, wrap = 1.3,
		rim = Vector2(0.008, 0.006), visor = Vector4(0.15, 0.006, 0.036, 0.28),
		vents = [-0.075, -0.032, 0.032, 0.075], vent_width = 0.012, stripe = true},
	"helmet_dome": {radius = Vector2(0.124, 0.142), height = 0.13, tail = 0.0, nape = -0.03, wrap = 1.5,
		rim = Vector2(0.012, 0.012), visor = Vector4.ZERO,
		vents = [], vent_width = 0.0, stripe = false},
	"helmet_trail": {radius = Vector2(0.124, 0.144), height = 0.118, tail = 0.0, nape = -0.038, wrap = 1.5,
		rim = Vector2(0.01, 0.008), visor = Vector4(0.17, 0.008, 0.062, 0.36),
		vents = [-0.052, 0.052], vent_width = 0.018, stripe = true},
	"helmet_aero": {radius = Vector2(0.114, 0.134), height = 0.098, tail = 0.075, nape = -0.004, wrap = 1.3,
		rim = Vector2(0.006, 0.005), visor = Vector4.ZERO,
		vents = [-0.045, 0.045], vent_width = 0.008, stripe = true},
}
