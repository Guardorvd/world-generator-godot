class_name GameConfig
extends RefCounted
## Константы игрового мира в метрах и секундах. Не зависят от отрисовки. Копия js/game/config.js.

const TILE := 4.0          # метров в одной клетке карты
const HS := 260.0          # метров на единицу высоты суши
const OCEAN_DEPTH := 45.0  # метров на единицу глубины океана
const EYE := 1.7           # высота глаз
const TREE_R := 330.0      # радиус, в котором показываются деревья
const GRASS_R := 52.0      # радиус травы
const GRASS_MAX := 12000   # наибольшее число пучков травы

# Движение игрока
const WALK := 4.6          # скорость шага, м/с
const RUN := 1.9           # множитель бега
const JUMP := 5.2          # начальная скорость прыжка, м/с
const GRAVITY := 16.0      # м/с²
const MOUSE := 0.0023      # радиан на пиксель движения мыши (умножается на чувствительность из настроек)
const FORD_DEPTH := 1.3    # глубже этого в воду не зайти
const WALK_ACCEL := 45.0   # разгон шага, м/с²: до полной скорости за доли секунды, но без рывка
const WALK_STOP := 30.0    # торможение, когда клавиши отпущены, м/с²
const AIR_CONTROL := 0.3   # доля разгона и торможения в прыжке
const COYOTE := 0.12       # сколько секунд после схода с края ещё можно прыгнуть
const JUMP_BUFFER := 0.12  # пробел, нажатый чуть раньше приземления, срабатывает при касании земли
const RUN_FOV := 5.0       # на сколько градусов шире обзор на бегу

# Велосипед
const BIKE_SPEED := 11.0   # крейсерская скорость с педалями на ровном лугу, м/с
const BIKE_BOOST := 1.3    # множитель, если крутить педали изо всех сил (Shift)
const BIKE_ACCEL := 4.0    # разгон, м/с²
const BIKE_BRAKE := 9.0    # торможение, м/с²
# Единый запас сцепления и аркадная инерция (м/с², секунды, 1/с).
const BIKE_GRIP := 10.5        # плотная земля; умножается на grip покрытия
const BIKE_BRAKE_RISE := 0.09 # быстрый плавный набор усилия
const BIKE_BRAKE_RELEASE := 0.16 # мягкое отпускание
const BIKE_CORNER_RESERVE := 0.52 # доля сцепления, сохраняемая рулю при полном тормозе
const BIKE_SIDE_RESPONSE := 18.0 # возврат боковой скорости; ниже — больше сноса
const BIKE_SLIP_YAW := 1.12    # небольшой выход курса за доступную боковую силу на скорости
const BIKE_SLIP_RECOVER := 0.14 # при таком угле сноса (~8°) руль мягко расширяет дугу
const BIKE_LOAD_TRANSFER := 0.028 # доля нагрузки вперёд на 1 м/с² торможения
const BIKE_REVERSE_WAIT := 0.38 # осознанное удержание уже после остановки
const BIKE_REVERSE_INPUT := 0.65 # лёгкое нажатие стика только удерживает тормоз
const BIKE_PITCH_LOAD := 0.004 # ход подвески на 1 м/с² продольного ускорения, м
const BIKE_BRAKE_SHIFT := 0.12 # компенсация корпуса назад при полном усилии, м
const BIKE_ROLL := 0.35    # сопротивление качению на ровном лугу, м/с²
const BIKE_DRAG := 0.007   # сопротивление на скорости: замедление = коэффициент × скорость²
const BIKE_REVERSE := 1.5  # скорость задним ходом, м/с
const BIKE_TURN := 1.9     # наибольшая скорость поворота руля, радиан в секунду
const BIKE_MOUNT := 3.0    # с какого расстояния можно сесть на велосипед, м
const BIKE_CAM := 4.5      # расстояние от камеры до седока, м
const BIKE_HOP := 4.2      # начальная скорость прыжка на велосипеде (пробел), м/с
const BIKE_FOV := 9.0      # на сколько градусов шире обзор на полной скорости
const BIKE_CRASH := 13.0   # удар о землю сильнее этого (м/с, примерно падение с 5 м) сбрасывает седока
