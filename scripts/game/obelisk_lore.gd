class_name ObeliskLore
extends RefCounted
## Обелиски (места "obelisk" StageSites): вид памятника и текст таблички на нём — один источник для модели, чтения таблички,
## видоискателя, задания «Летопись обелисков» и альбома. Генерация мест не затронута: вид и текст считаются из сида мира
## и id места (WorldData.place_id) и всегда одни и те же для того же мира. Без узлов сцены.
## Вид: 0 — целый обелиск, 1 — разрушенный (столб сломан, верх лежит рядом), 2 — старая статуя на постаменте,
## 3 — обломки колонны на плите, 4 — памятная стела. Модели — ObeliskModels (ключи в каталоге ObeliskModels.KEYS).

const FORMS := 5
const NEAR_CELLS := 70.0  # клеток: дальше поселение или вершина в тексте не упоминаются

const WHAT := [
	["Строгий каменный столб, который поставили здесь так давно, что его хозяева забыты.",
		"Прямой обелиск из серого камня: его грани до сих пор ровные, хотя ветер и дожди поработали над ними.",
		"Высокий столб на широком основании. Вокруг него тропа сама разошлась в стороны: проходящие кланяются обелиску."],
	["От обелиска остался сломанный столб: верхняя часть лежит рядом, как упала.",
		"Столб расколот посередине. Верх свалился в траву и зарос мхом, а нижняя часть всё ещё стоит прямо.",
		"Этот обелиск не пережил непогоды: он обломан, но основание и надпись целы."],
	["Старая статуя на постаменте: лицо стёрто временем, но осанка сохранилась.",
		"Каменная фигура в плаще смотрит вдоль дороги. Постамент выветрился сильнее самой статуи.",
		"Статуя странника: одна рука поднята, будто он показывает путь."],
	["Здесь стояла колонна: теперь на плите лежат её обломки, а часть уцелела и стоит на месте.",
		"Куски колонны разбросаны вокруг плиты. По обломкам видно, что она была высокой.",
		"От колонны остались барабаны и несколько блоков. Плита под ними выдержала столетия."],
	["Памятная стела: широкая плита на низком основании, края сколоты, но поверхность гладкая.",
		"Тёсаная стела, вросшая в землю. На её лицевой стороне видны следы резьбы.",
		"Широкая каменная плита, поставленная на ребро. Основание обложено тёсаными блоками."],
]
const WHY := [
	"Памятник поставили {when} в память о тех, кто {deed} {near}.",
	"Говорят, {when} тот, кто {deed} {near}, остановился именно здесь; камень поставили, чтобы об этом помнили.",
	"Знак поставлен {when}: так отметили место, где кто-то {deed} {near}.",
]
const DEEDS := [
	"прокладывал первую дорогу",
	"переждал долгую зиму",
	"вывел заблудившийся обоз",
	"впервые перешёл вброд реку",
	"заложил первый дом",
	"сложил здесь тур для путников",
	"остановил весенний паводок",
	"нашёл воду в сухой год",
]
const WHENS := ["очень давно", "больше трёх веков назад", "в год большого снега", "ещё до первых поселений", "за сотню лет до наших дней", "в год великого тумана"]
const END := [
	"Надпись на табличке читается без труда.",
	"Табличку поправляли и не раз: бронза потемнела, но слова целы.",
	"Рядом никого нет, только ветер переворачивает листья.",
	"Путники оставляют у подножия камешек и идут дальше.",
]


## Вид памятника места id мира с зерном seed_num (0..FORMS − 1)
static func form_of(seed_num: int, id: String) -> int:
	return absi(hash("%d|%s|obelisk-form" % [seed_num, id])) % FORMS


## Табличка места: {title, text, form}. place — запись места (name, x, y — клетки, id или key); world даёт ближайшие
## поселение и вершину по названию. Одно и то же для одного мира.
static func describe(world: WorldData, place: Dictionary) -> Dictionary:
	var id: String = place.get("key", place.get("id", ""))
	var form := form_of(world.seed_num, id)
	var rng := RandomNumberGenerator.new()
	rng.seed = hash("%d|%s|obelisk-text" % [world.seed_num, id])
	var near := _near(world, Vector2(place.x, place.y))
	var what: Array = WHAT[form]
	var text := "%s %s %s" % [what[rng.randi() % what.size()], _why(rng, near), END[rng.randi() % END.size()]]
	return {title = str(place.get("name", "Обелиск")), text = text, form = form}


static func _why(rng: RandomNumberGenerator, near: String) -> String:
	var line: String = WHY[rng.randi() % WHY.size()]
	return line.format({when = WHENS[rng.randi() % WHENS.size()], deed = DEEDS[rng.randi() % DEEDS.size()], near = near})


## «у поселения «X»» / «под вершиной «Y»» — что ближе, но не дальше NEAR_CELLS; иначе «в этих местах»
static func _near(world: WorldData, at: Vector2) -> String:
	var best := ""
	var best_d := NEAR_CELLS
	for s in world.settlements:
		var d := Vector2(s.x, s.y).distance_to(at)
		if d < best_d:
			best_d = d
			best = "у поселения «%s»" % s.name
	for p in world.peaks:
		var d := Vector2(p.x, p.y).distance_to(at)
		if d < best_d:
			best_d = d
			best = "под вершиной «%s»" % p.name
	return best if best != "" else "в этих местах"
