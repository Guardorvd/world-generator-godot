extends RefCounted
## Трасса 20 Trail Lab (31.10): «Долина» — многоуровневая местность 512 × 512 м: долина с сухим каменистым руслом,
## склоны с обеих сторон и перевал в верховье. Две полосы (клавиши 1 и 2):
##   1. Грэвел — широкая гравийная петля: серпантином вверх по восточному склону к перевалу, через верховье русла,
##      вниз по западному склону и обратно к лагерю; броды-ложбины, стиральная доска, быстрые перегибы.
##   2. МТБ — синглтрек с востока за петлёй вниз в долину: дважды над гравийной дорогой по высоким деревянным
##      мостам, по мосту и дважды вброд через русло, корни, бревно, узкий проход.
## Линии проложены по рельефу поиском (tools/control/trail_lines), как у горы (trail_lab_summit.gd).

const Polygon = preload("res://scripts/lab/trail_lab_polygon.gd")
const CELLS := Polygon.CELLS
const SIZE := Polygon.SIZE

## Станции пересечений: МТБ над грэвелом (станция МТБ, станция грэвела).
const CROSSINGS := [Vector2(134.3, 625.5), Vector2(675.7, 1387.0)]
## Станции МТБ через русло: мост и два брода.
const CREEK_BRIDGE := 290.0
const CREEK_FORDS := [390.0, 508.0]
## Станции грэвела через русло.
const GRAVEL_FORDS := [1698.0]

static func creek_x(z: float) -> float:
	return 256.0 + 24.0 * sin(z / 55.0)

## Природная земля долины (без выемок): уклон к югу, склоны, верховье, русло, холмы.
static func base(at: Vector2) -> float:
	var x := at.x
	var z := at.y
	var sides := 42.0 * (1.0 - exp(-pow((x - 256.0) / 150.0, 2.0)))
	var head := 14.0 * pow(clampf((z - 380.0) / 110.0, 0.0, 1.0), 2.0) * exp(-pow((x - 256.0) / 170.0, 2.0))
	var creek := -3.2 * exp(-pow((x - creek_x(z)) / 5.5, 2.0)) * clampf((z - 50.0) / 40.0, 0.0, 1.0) * clampf((470.0 - z) / 30.0, 0.0, 1.0)
	var hills := 2.2 * sin(x / 43.0) * sin(z / 39.0) + 1.0 * sin((x + z) / 27.0) + 1.4 * sin((x - 1.7 * z) / 61.0)
	return 10.0 + 0.10 * z + sides + head + creek + hills

## Земля: природная. Выемку под мостами грэвел засыпал своим профилем (оставался провал 1,5 м на 4 м — падение на
## скорости), поэтому мосты МТБ высокие (3,4 м), и гравийная дорога проходит под ними ровно.
static func ground(at: Vector2) -> float:
	return base(at)

static func forest(w: WorldData, routes: Array[TrailDefinition]) -> void:
	Polygon.forest(w, routes)

static func _points(flat: Array) -> PackedVector2Array:
	var pts := PackedVector2Array()
	for i in range(0, flat.size(), 2): pts.append(Vector2(flat[i], flat[i + 1]))
	return pts

static func routes() -> Array[TrailDefinition]:
	var gravel := TrailDefinition.new()
	gravel.id = "course_valley_gravel"
	gravel.title = "Грэвел"
	gravel.kind = "mountain"
	gravel.width = 5.2
	gravel.surface = RoadSurface.GRAVEL
	gravel.earthwork = 1.0
	gravel.auto_bank = 1.0
	gravel.closed = true
	gravel.points = _points(GRAVEL_LINE)
	gravel.shaping = TrailShaping.preset("road")
	gravel.shaping.grade_limit = 0.14
	gravel.shaping.level_window = 10.0
	gravel.shaping.bank_max = 0.1
	gravel.elements = gravel_elements(gravel)
	var mtb := TrailDefinition.new()
	mtb.id = "course_valley_mtb"
	mtb.title = "МТБ"
	mtb.kind = "trail"
	mtb.width = 3.0
	mtb.surface = RoadSurface.FOREST
	mtb.earthwork = 1.0
	mtb.auto_bank = 0.6
	mtb.points = _points(MTB_LINE)
	mtb.shaping = TrailShaping.preset("trail")
	mtb.shaping.grade_limit = 0.26
	mtb.shaping.side_follow = 0.4
	mtb.shaping.bank_max = 0.12
	mtb.elements = mtb_elements(mtb)
	var kit: Array[TrailDefinition] = [gravel, mtb]
	return kit

static func _put(list: Array[TrailElement], profile: int, station: float, length: float, height: float, count := 3, gap := 0.0) -> TrailElement:
	var e := TrailElementLibrary.make(profile, station, length, height, 1.0, count)
	e.seed = 2000 + int(station)
	if gap > 0.0: e.gap = gap
	list.append(e)
	return e

static func gravel_elements(d: TrailDefinition) -> Array[TrailElement]:
	var T := TrailElement.Profile
	var list := Summit.berms(d, 26.0, 0.25, 0.6)
	# броды через русло: ложбина с каменистым дном
	for s: float in GRAVEL_FORDS: _put(list, T.DIP, s, 14.0, 0.5)
	# подъём серпантином: стиральная доска и разбитое полотно (под мостами МТБ — у 625 и 1387 м — чисто)
	_put(list, T.RIPPLES, 260.0, 30.0, 0.06)
	_put(list, T.ROUGH, 350.0, 22.0, 0.1)
	# перевал: перегибы, колеи, длинные волны, рябь
	(_put(list, T.ROLLOVER, 655.0, 18.0, 0.8) as TrailElement).skew = 0.4
	(_put(list, T.ROLLOVER, 705.0, 18.0, 0.8) as TrailElement).skew = 0.4
	_put(list, T.RUTS, 760.0, 20.0, 0.15)
	_put(list, T.WAVES, 822.0, 36.0, 0.4, 3)
	_put(list, T.RIPPLES, 900.0, 24.0, 0.06)
	# спуск: перегиб, разбитое полотно, роллеры — на скорости короткий подлёт — и ложбина
	(_put(list, T.ROLLOVER, 1022.0, 20.0, 0.9) as TrailElement).skew = 0.4
	_put(list, T.ROUGH, 1062.0, 20.0, 0.1)
	_put(list, T.ROLLER, 1162.0, 16.0, 0.8)
	_put(list, T.ROLLER, 1212.0, 16.0, 0.9)
	_put(list, T.DIP, 1262.0, 14.0, 0.6)
	_put(list, T.RIPPLES, 1346.0, 24.0, 0.06)
	(_put(list, T.ROLLOVER, 1440.0, 18.0, 0.8) as TrailElement).skew = 0.4
	_put(list, T.ROLLER, 1537.0, 16.0, 0.8)
	list.sort_custom(func(a: TrailElement, b: TrailElement) -> bool: return a.station < b.station)
	return list

static func mtb_elements(d: TrailDefinition) -> Array[TrailElement]:
	var T := TrailElement.Profile
	var list := Summit.berms(d, 32.0, 0.3, 0.8)
	# мосты над грэвелом: настил над выемкой
	for c: Vector2 in CROSSINGS: (_put(list, T.NORTHSHORE, c.x, 56.0, 3.4, 3, 2.5) as TrailElement).skew = 0.7
	# мост через русло (сходит на землю с обеих сторон) и броды по камням
	(_put(list, T.NORTHSHORE, CREEK_BRIDGE, 20.0, 0.8, 3, 2.5) as TrailElement).skew = 0.7
	for s: float in CREEK_FORDS: _put(list, T.ROCK_GARDEN, s, 12.0, 0.12)
	# спуск с востока: корни и перегиб, дроп на крутом
	_put(list, T.ROOTS, 25.0, 16.0, 0.08)
	(_put(list, T.ROLLOVER, 46.0, 12.0, 0.6) as TrailElement).skew = 0.3
	_put(list, T.DROP, 202.0, 12.0, 0.9)
	# ровная полка у русла: памп и бревно, узкий проход
	_put(list, T.PUMP, 322.0, 27.0, 0.5, 3)
	(_put(list, T.LOG, 346.0, 6.0, 0.22, 1) as TrailElement).gap = 1.0
	(_put(list, T.NARROW, 423.0, 10.0, 0.45) as TrailElement).gap = 2.0
	# подъём к западному склону: корни и камни
	_put(list, T.ROOTS, 540.0, 14.0, 0.08)
	_put(list, T.ROCK_GARDEN, 570.0, 14.0, 0.1)
	_put(list, T.ROOTS, 730.0, 14.0, 0.08)
	_put(list, T.ROCK_GARDEN, 790.0, 14.0, 0.1)
	list.sort_custom(func(a: TrailElement, b: TrailElement) -> bool: return a.station < b.station)
	return list

