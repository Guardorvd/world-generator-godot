## Трасса 19 Trail Lab (31.10): «Гора» — массив с крутой западной гранью, хребтом на юго-восток и отдельным холмом,
## на одной местности 512 × 512 м две полосы с общей вершиной и финишем внизу (клавиши 1 и 2):
##   1. Даунхилл — с вершины по западной грани: развороты на крутом, S-дуги через отроги, каменные участки, дроп,
##      гэпы и линии столов в нижнем лесу.
##   2. Кросс-кантри — спиралью с вершины, серпантином по бокам хребта, тягун спиралью на холм и flow-спуск.
## Линии не нарисованы опорными точками, а проложены по рельефу поиском с пределом уклона и ценой поворота
## (как ходит настоящая тропа: по горизонталям, разворотом — где склон круче; tools/control/trail_lines),
## сглажены и сохранены здесь точками через 2 м.

const Polygon = preload("res://scripts/lab/trail_lab_polygon.gd")
const CELLS := Polygon.CELLS
const SIZE := Polygon.SIZE
## Выше этой линии (z, м) — открытая вершина: редкий лес.
const MEADOW := 395.0

## Земля: конус вершины, хребет на юго-восток (A → B), холм на юго-востоке и кулуар на западной грани.
const RIDGE_A := Vector2(250, 458)
const RIDGE_B := Vector2(438, 214)
static func ground(at: Vector2) -> float:
	var cone := 150.0 / (1.0 + pow(at.distance_to(Vector2(250, 458)) / 200.0, 1.5))
	var ab := RIDGE_B - RIDGE_A
	var u := clampf((at - RIDGE_A).dot(ab) / ab.length_squared(), 0.0, 1.0)
	var ridge := (146.0 - 72.0 * u) * exp(-pow(at.distance_to(RIDGE_A + ab * u) / 95.0, 2.0))
	var hill := 42.0 + 32.0 * exp(-pow((at.x - 430.0) / 70.0, 2.0) - pow((at.y - 140.0) / 62.0, 2.0))
	var gx := 165.0 + 15.0 * sin(at.y / 70.0)
	var gully := -5.0 * exp(-pow((at.x - gx) / 8.0, 2.0)) * clampf((at.y - 120.0) / 150.0, 0.0, 1.0) * clampf((440.0 - at.y) / 60.0, 0.0, 1.0)
	var hills := 2.6 * sin(at.x / 41.0) * sin(at.y / 37.0) + 1.2 * sin((at.x + at.y) / 23.0) + 1.5 * sin((at.x - 2.0 * at.y) / 53.0)
	return 8.0 + maxf(maxf(cone, ridge), hill) + gully + hills

## Лес до края полотна; на вершине — редколесье (каждый пятый объект).
static func forest(w: WorldData, routes: Array[TrailDefinition]) -> void:
	Polygon.forest(w, routes)
	var chunks := w.chunks
	for c in chunks.size():
		var kept := PackedInt32Array()
		for o in chunks[c]:
			if w.obj_y[o] * GameConfig.TILE < MEADOW or o % 5 == 0: kept.append(o)
		chunks[c] = kept
	w.chunks = chunks

static func _points(flat: Array) -> PackedVector2Array:
	var pts := PackedVector2Array()
	for i in range(0, flat.size(), 2): pts.append(Vector2(flat[i], flat[i + 1]))
	return pts

static func routes() -> Array[TrailDefinition]:
	var dh := TrailDefinition.new()
	dh.id = "course_summit_dh"
	dh.title = "Даунхилл"
	dh.kind = "mountain"
	dh.width = 4.2
	dh.surface = RoadSurface.DIRT
	dh.earthwork = 1.0
	dh.auto_bank = 1.0
	dh.points = _points(DH_LINE)
	dh.shaping = TrailShaping.preset("mountain")
	dh.shaping.grade_limit = 0.34
	dh.shaping.level_window = 6.0
	dh.shaping.side_follow = 0.2
	dh.shaping.bank_max = 0.3
	dh.elements = dh_elements(dh)
	var xc := TrailDefinition.new()
	xc.id = "course_summit_xc"
	xc.title = "Кросс-кантри"
	xc.kind = "trail"
	xc.width = 3.4
	xc.surface = RoadSurface.FOREST
	xc.earthwork = 1.0
	xc.auto_bank = 1.0
	xc.points = _points(XC_LINE)
	xc.shaping = TrailShaping.preset("mountain")
	xc.shaping.grade_limit = 0.2
	xc.shaping.level_window = 6.0
	xc.shaping.side_follow = 0.15
	xc.shaping.bank_max = 0.18
	xc.elements = xc_elements(xc)
	var kit: Array[TrailDefinition] = [dh, xc]
	return kit

## Виражи во всех поворотах туже radius: на всю длину дуги, высота — от радиуса.
static func berms(d: TrailDefinition, radius: float, low: float, high: float) -> Array[TrailElement]:
	var list: Array[TrailElement] = []
	var length := d.route_length()
	var at := 6.0
	while at < length - 6.0:
		if absf(d.curvature_at(at)) < 1.0 / radius:
			at += 1.0
			continue
		var sign := signf(d.curvature_at(at))
		var from := at
		var tightest := 0.0
		while at < length - 6.0 and absf(d.curvature_at(at)) >= 0.7 / radius and signf(d.curvature_at(at)) == sign:
			tightest = maxf(tightest, absf(d.curvature_at(at)))
			at += 1.0
		var span := clampf(at - from + 8.0, 12.0, 44.0)
		var mid := (from + at) * 0.5
		if mid - span * 0.5 > 2.0 and mid + span * 0.5 < length - 2.0:
			var height := lerpf(low, high, smoothstep(1.0 / radius, 1.0 / 7.0, tightest))
			list.append(TrailElementLibrary.make(TrailElement.Profile.BERM, mid, span, height, sign))
		at += 2.0
	return list

## Элемент на станции; seed — от станции, чтобы камни и корни не повторяли друг друга.
static func _put(list: Array[TrailElement], profile: int, station: float, length: float, height: float, count := 3, gap := 0.0) -> TrailElement:
	var e := TrailElementLibrary.make(profile, station, length, height, 1.0, count)
	e.seed = 1900 + int(station)
	if gap > 0.0: e.gap = gap
	list.append(e)
	return e

## Элементы стоят в участках между виражами (найдены по готовой линии: длина, уклон, скорость flow-заезда).
static func dh_elements(d: TrailDefinition) -> Array[TrailElement]:
	var T := TrailElement.Profile
	var list := berms(d, 28.0, 0.6, 1.3)
	# вершина, −24 %: каменный сад с двумя чистыми линиями
	_put(list, T.ROCK_GARDEN, 28.0, 22.0, 0.16)
	# крутой склон −22 %: деревянная платформа обрывается дропом 1,4 м
	_put(list, T.NORTHSHORE, 150.0, 14.0, 1.4, 3, 2.2)
	_put(list, T.ROOTS, 214.0, 16.0, 0.12)
	# отрог −7 %: линия гэп — стол
	_put(list, T.GAP, 284.0, 18.0, 1.4, 3, 3.5)
	_put(list, T.TABLETOP, 314.0, 22.0, 1.7)
	# крутая грань −21 %: большой гэп вниз по склону и дроп
	_put(list, T.GAP, 380.0, 22.0, 1.8, 3, 5.0)
	_put(list, T.DROP, 410.0, 14.0, 1.2)
	# нижний лес
	_put(list, T.PUMP, 512.0, 30.0, 0.55, 3)
	_put(list, T.TABLETOP, 541.0, 22.0, 1.6)
	_put(list, T.GAP, 605.0, 18.0, 1.4, 3, 3.5)
	_put(list, T.TABLETOP, 632.0, 20.0, 1.5)
	# финишная прямая: памп, гэп, большой стол
	_put(list, T.PUMP, 728.0, 30.0, 0.55, 3)
	_put(list, T.GAP, 757.0, 20.0, 1.5, 3, 4.0)
	_put(list, T.TABLETOP, 785.0, 22.0, 1.8)
	list.sort_custom(func(a: TrailElement, b: TrailElement) -> bool: return a.station < b.station)
	return list

static func xc_elements(d: TrailDefinition) -> Array[TrailElement]:
	var T := TrailElement.Profile
	var list := berms(d, 24.0, 0.35, 0.9)
	# спуск с вершины
	_put(list, T.ROOTS, 170.0, 16.0, 0.08)
	(_put(list, T.ROLLOVER, 192.0, 14.0, 0.8) as TrailElement).skew = 0.3
	# бок хребта: стол, памп и камни
	_put(list, T.TABLETOP, 292.0, 20.0, 1.4)
	_put(list, T.PUMP, 320.0, 30.0, 0.55, 3)
	_put(list, T.ROCK_GARDEN, 351.0, 14.0, 0.12)
	_put(list, T.GAP, 402.0, 18.0, 1.4, 3, 3.5)
	_put(list, T.TABLETOP, 430.0, 22.0, 1.5)
	_put(list, T.ROOTS, 456.0, 14.0, 0.08)
	# длинный траверс над восточной долиной: памп, бревно, стол, камни, гэп, памп, корни
	_put(list, T.PUMP, 530.0, 40.0, 0.55, 4)
	(_put(list, T.LOG, 566.0, 6.0, 0.22, 1) as TrailElement).gap = 1.4
	_put(list, T.TABLETOP, 590.0, 20.0, 1.4)
	_put(list, T.ROCK_GARDEN, 620.0, 16.0, 0.12)
	_put(list, T.GAP, 650.0, 18.0, 1.4, 3, 3.5)
	_put(list, T.PUMP, 685.0, 30.0, 0.55, 3)
	_put(list, T.ROOTS, 720.0, 16.0, 0.08)
	# тягун на холм: корни и камни на подъёме
	_put(list, T.ROOTS, 812.0, 14.0, 0.08)
	_put(list, T.ROCK_GARDEN, 860.0, 14.0, 0.1)
	# спуск с холма и финиш: стол, памп, перегиб, flow-линия памп — гэп — стол
	_put(list, T.TABLETOP, 1036.0, 20.0, 1.4)
	_put(list, T.PUMP, 1058.0, 18.0, 0.5, 2)
	(_put(list, T.ROLLOVER, 1145.0, 14.0, 0.8) as TrailElement).skew = 0.3
	_put(list, T.PUMP, 1225.0, 30.0, 0.55, 3)
	_put(list, T.GAP, 1255.0, 18.0, 1.4, 3, 3.5)
	_put(list, T.TABLETOP, 1285.0, 22.0, 1.5)
	list.sort_custom(func(a: TrailElement, b: TrailElement) -> bool: return a.station < b.station)
	return list

